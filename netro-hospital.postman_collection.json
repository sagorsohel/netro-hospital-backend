    {
      "name": "05. Pharmacy System (Multi-Pharmacy)",
      "description": "Independent pharmacies with their own auth. Hospital admins create pharmacies (sequential IDs from 1001) and their owner. Pharmacy users log in with pharmacyId + phone + password. Roles: owner, manager, pharmacist, cashier, staff. Pharmacy tokens cannot call hospital APIs; hospital admin tokens have full access to every pharmacy.",
      "item": [
        {
          "name": "Admin - Pharmacy Registry",
          "item": [
            {
              "name": "Create Pharmacy + Owner",
              "request": {
                "method": "POST",
                "header": [
                  {
                    "key": "Content-Type",
                    "value": "application/json"
                  },
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pharmacies",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "pharmacies"]
                },
                "description": "Creates a pharmacy and its first owner account in one transaction. Saves the new ID to {{pharmacyId}}.",
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"name\": \"Netro Lifecare Pharmacy\",\n  \"address\": \"Road 11, Banani, Dhaka\",\n  \"phone\": \"+8801911000001\",\n  \"email\": \"banani@netropharmacy.com\",\n  \"licenseNo\": \"DGDA-PH-2026-0003\",\n  \"owner\": {\n    \"name\": \"Arif Hasan\",\n    \"phone\": \"01911000001\",\n    \"email\": \"\",\n    \"password\": \"12345678\"\n  }\n}"
                }
              },
              "event": [
                {
                  "listen": "test",
                  "script": {
                    "type": "text/javascript",
                    "exec": ["const res = pm.response.json();", "if (res.data && res.data.id) pm.collectionVariables.set('pharmacyId', res.data.id);"]
                  }
                }
              ]
            },
            {
              "name": "List Pharmacies",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
                ],
                "url": {
                  "raw": "{{baseUrl}}/api/v1/pharmacies?search=&isActive=&page=1&limit=10",
                  "host": ["{{baseUrl}}"],
                  "path": ["api", "v1", "pharmacies"],
                  "query": [
                    {
                      "key": "search",
                      "value": ""
                    },
                    {
                      "key": "isActive",
                      "value": ""
                    },
                    {
                      "key": "page",
                      "value": "1"
                    },
                    {
                      "key": "limit",
                      "value": "10"
                    }
                  ]
                },
                "description": "search matches name, license no, phone, or exact numeric ID. isActive=true|false."
              }
            },
            {
              "name": "Get Pharmacy",
              "request": {
                "method": "GET",
                "header": [
                  {
                    "key": "Authorization",
                    "value": "Bearer {{adminToken}}"
                  }
